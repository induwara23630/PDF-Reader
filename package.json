{
  "name": "bpdf-reader",
  "version": "1.0.0",
  "description": "BPDF Reader — a clean, simple desktop app for reading PDF files.",
  "author": "rusiruibandara",
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "copy-pdfjs": "node scripts/copy-pdfjs.js",
    "prestart": "npm run copy-pdfjs",
    "start": "electron .",
    "build-icon": "electron scripts/build-icon.js",
    "predist": "npm run copy-pdfjs",
    "dist": "electron-builder",
    "predist:dir": "npm run copy-pdfjs",
    "dist:dir": "electron-builder --dir"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2"
  },
  "build": {
    "appId": "com.rusiru.bpdfreader",
    "productName": "BPDF Reader",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/icon.ico",
      "!**/*.map"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "BPDF Reader"
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "role": "Viewer"
      }
    ]
  }
}
